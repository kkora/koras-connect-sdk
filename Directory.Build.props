<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.0-preview.2</Version><Authors>Koras Technologies</Authors>
    <RepositoryUrl>https://github.com/kkora/koras-connect-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType><PackageReadmeFile>README.md</PackageReadmeFile>
    <Deterministic>true</Deterministic><ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <NuGetAudit>true</NuGetAudit><NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>
  <ItemGroup><None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" /></ItemGroup>
</Project>
